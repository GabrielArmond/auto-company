NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Comma-separated keys accepted in the X-API-Key header (at least 32 characters each).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=replace-with-a-random-key-of-at-least-32-characters

# Firebase service account (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
