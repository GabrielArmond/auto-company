NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Comma-separated keys accepted in the X-API-Key header (at least 32 characters each).
# This is a local demo key; for real deployments generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=local-demo-api-key-change-me-0123456789

# memory (default, no setup, data is lost on restart) or firestore
DATABASE=memory

# DATABASE=firestore with the local emulator (docker compose up firestore); no credentials needed
# FIRESTORE_EMULATOR_HOST=localhost:8080

# DATABASE=firestore with a real Firebase project: service account
# (Project settings > Service accounts > Generate new private key)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
